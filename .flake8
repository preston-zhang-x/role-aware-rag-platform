[flake8]
max-line-length = 120
extend-ignore = E203,W503
exclude =
    .agent,
    .git,
    .sisyphus,
    .venv,
    .pytest_cache,
    .mypy_cache,
    .tmp,
    __pycache__,
    *.egg-info,
    script,
    frontend/node_modules,
    frontend/dist,
    frontend/dist-ssr,
    frontend/.vite,
    frontend/coverage,
    frontend/playwright-report,
    frontend/test-results
